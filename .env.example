# OmniRouteConfig + OmniRoute env vars.
#
# Don't edit this file. Run `omniroutectl env-sync` to generate `.env`
# from your shell + auto-generated secrets. This `.env.example` is
# documentation only — every variable that OmniRouteConfig knows
# about is listed below with its purpose.
#
# Precedence on every variable when env_sync runs:
#     existing .env > shell env > generated default
# Existing values are NEVER overwritten. Secrets stay stable across
# `omniroutectl up` runs (otherwise admin sessions would die on every
# restart).

# ============================================================
# OmniRouteConfig wiring
# ============================================================

# Base URL where OmniRoute is reachable. OmniRouteConfig will start
# OmniRoute on this URL if nothing answers.
OMNIROUTE_URL=http://localhost:20128
OMNIROUTE_PORT=20128

# Management bearer token for /api/providers, /api/keys, etc. AFTER you
# sign up an admin account on the dashboard, generate a token there
# (Dashboard → API Keys) and paste it here. Without this, every POST
# from `omniroutectl configure` returns 401.
OMNIROUTE_API_TOKEN=

# Override the bundled catalog file. Default: <package>/config/free-providers.yaml
# OMNI_ROUTE_CONFIG_PATH=/abs/path/to/free-providers.yaml

# Override docker run defaults. Useful if you build OmniRoute yourself
# (e.g. `omniroute:full` from your local fork).
# OMNIROUTE_CONTAINER=omniroute
# OMNIROUTE_IMAGE=diegosouzapw/omniroute:latest
# OMNIROUTE_VOLUME=omniroute-data
# OMNIROUTE_ENV_FILE=.env

# ============================================================
# OmniRoute server secrets — DO NOT COMMIT
# Auto-generated by `omniroutectl env-sync` if missing.
# ============================================================

# Admin session signing — invalidating it logs out every admin.
# Generate: openssl rand -base64 48
JWT_SECRET=

# HMAC for management bearer tokens issued by OmniRoute.
# Generate: openssl rand -hex 32
API_KEY_SECRET=

# At-rest encryption for provider API keys stored in OmniRoute's SQLite.
# Generate: openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_VERSION=v1

# Stability salt for OmniRoute's machine-id fingerprint.
MACHINE_ID_SALT=

# ============================================================
# OmniRoute admin (you set this on dashboard signup)
# Intentionally NOT auto-generated. Set manually if you want a deterministic
# first-run admin password; otherwise just type whatever you want into the
# dashboard signup form.
# ============================================================
INITIAL_PASSWORD=

# ============================================================
# OmniRoute server runtime defaults
# ============================================================
NODE_ENV=production
PORT=20128
INSTANCE_NAME=omniroute
DATA_DIR=/app/data
STORAGE_DRIVER=sqlite
BASE_URL=http://localhost:20128
NEXT_PUBLIC_BASE_URL=http://localhost:20128
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false
ALLOW_API_KEY_REVEAL=false
PROVIDER_LIMITS_SYNC_INTERVAL_MINUTES=70
DISABLE_SQLITE_AUTO_BACKUP=false

# ============================================================
# Provider API keys
# Sign up + paste; missing keys are skipped during `configure`.
# Aliases declared in `config/free-providers.yaml` are also honored
# (e.g. CLAUDE_CONSOLE_API_KEY → ANTHROPIC_API_KEY).
# ============================================================

# Highest priority — fast + generous free RPD.
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=

# Generalist multi-modal.
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=

# Specialists.
DEEPSEEK_API_KEY=
FIREWORKS_API_KEY=
COHERE_API_KEY=

# Multimodal (audio).
# REPLICATE_API_TOKEN=    # not in OmniRoute v3.7.x — re-enable when node lands
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# Web search (OmniRoute /api/v1/search).
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=

# Paid fallbacks — only filled if you want OmniRoute to route to paid
# models when free options exhaust.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
