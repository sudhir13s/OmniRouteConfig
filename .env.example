# omni-route-config + OmniRoute env vars.
#
# Copy to `.env` (gitignored), fill in only the keys you have. Missing
# keys are silently skipped from the catalog at configure time.

# === omni-route-config wiring ===
# Where OmniRoute is reachable. omni-route-config will start it here if
# nothing answers.
OMNIROUTE_URL=http://localhost:20128
OMNIROUTE_PORT=20128
# Optional bearer token for OmniRoute admin API. Leave blank if
# OmniRoute is running with REQUIRE_API_KEY=false.
OMNIROUTE_API_TOKEN=

# Override the bundled catalog file:
# OMNI_ROUTE_CONFIG_PATH=/abs/path/to/free-providers.yaml

# === Free-tier provider keys (sign up + paste; missing => skipped) ===
# Highest priority — very fast, generous free RPD per model.
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=

# Generalist multi-modal.
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=

# Specialists.
DEEPSEEK_API_KEY=
FIREWORKS_API_KEY=
COHERE_API_KEY=

# Multimodal (image / video / audio).
REPLICATE_API_TOKEN=
FAL_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# Web search (OmniRoute /api/v1/search).
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=

# Paid fallbacks — ONLY filled if you want OmniRoute to route to paid
# models when free options exhaust. Leave blank to enforce free-only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
